    "test": "node --test",
    "audit:runtime": "npm audit --omit=dev"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "DESIGN.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
