{
  "name": "@mcky/ui",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./core.css": "./src/styles/core.css",
    "./svelte": "./src/lib/index.ts",
    "./v5-tokens.css": "./src/styles/v5-tokens.css",
    "./badge": "./src/lib/components/Badge.svelte",
    "./button": "./src/lib/components/Button.svelte",
    "./card": "./src/lib/components/Card.svelte",
    "./checkbox": "./src/lib/components/Checkbox.svelte",
    "./chip": "./src/lib/components/Chip.svelte",
    "./empty-state": "./src/lib/components/EmptyState.svelte",
    "./field": "./src/lib/components/Field.svelte",
    "./count-sticker": "./src/lib/components/CountSticker.svelte",
    "./input": "./src/lib/components/Input.svelte",
    "./kbd": "./src/lib/components/Kbd.svelte",
    "./monogram": "./src/lib/components/Monogram.svelte",
    "./select": "./src/lib/components/Select.svelte",
    "./segmented": "./src/lib/components/Segmented.svelte",
    "./squiggle": "./src/lib/components/Squiggle.svelte",
    "./switch": "./src/lib/components/Switch.svelte",
    "./textarea": "./src/lib/components/Textarea.svelte",
    "./top-bar": "./src/lib/components/TopBar.svelte"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "dev": "vite --config vite.playground.config.ts",
